# Local Supabase (default — works after `npx supabase start`)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Run `npx supabase status` after starting Supabase and copy the
# value labelled `anon key` here. The CLI prints it once on start.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Phone testing tip: replace 127.0.0.1 with the Mac's LAN IP
# (find it with: `ipconfig getifaddr en0`) so Expo Go can reach it.
